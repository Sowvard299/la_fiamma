---
import Base from '../layouts/Base.astro';
import Entete from '../components/Entete.astro';
import Accueil from '../components/Accueil.astro';
import Bandeau from '../components/Bandeau.astro';
import Carte from '../components/Carte.astro';
import Avis from '../components/Avis.astro';
import Acces from '../components/Acces.astro';
import Reserver from '../components/Reserver.astro';
import PiedDePage from '../components/PiedDePage.astro';
import BarreMobile from '../components/BarreMobile.astro';
---

<Base>
  <Entete />
  <main id="contenu">
    <Accueil />
    <Bandeau />
    <Carte />
    <Avis />
    <Acces />
    <Reserver />
  </main>
  <PiedDePage />
  <BarreMobile />
</Base>
