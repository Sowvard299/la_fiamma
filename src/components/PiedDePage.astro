---
import { infos } from '../data/infos';
import { avis } from '../data/avis';

interface Props {
  /** Préfixe des ancres : vide sur l'accueil, l'adresse de l'accueil sur les autres pages. */
  accueil?: string;
}
const { accueil = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const annee = new Date().getFullYear();
const google = avis.sources.find((s) => s.nom === 'Google')!;
---

<footer class="pied">
  <div class="pied__grille conteneur">
    <p class="pied__nom">{infos.nom}</p>

    <div class="pied__colonne">
      <p>{infos.description}</p>
      <p>{`${infos.adresse.rue}, ${infos.adresse.codePostal} ${infos.adresse.ville}`}</p>
    </div>

    <div class="pied__colonne">
      <p><a class="chiffres" href={`tel:${infos.telephone.international}`}>{infos.telephone.affichage}</a></p>
      <p><a href={`mailto:${infos.email}`}>{infos.email}</a></p>
    </div>

    <div class="pied__colonne">
      <p><a href={`${accueil}#carte`}>La carte</a></p>
      <p><a href={`${accueil}#avis`}>Avis</a></p>
      <p><a href={`${accueil}#acces`}>Accès et horaires</a></p>
      <p><a href={`${accueil}#reserver`}>Réserver</a></p>
    </div>

    <div class="pied__bas">
      <p>© {annee} {infos.nom}. Prix nets, service compris.</p>
      <p class="pied__liens">
        <a href={`${base}/mentions-legales/`}>Mentions légales et crédits</a>
        <a href={infos.theFork} rel="noopener">La Fiamma sur TheFork</a>
        <a href={google.url} rel="noopener">La Fiamma sur Google</a>
      </p>
      <p>Photos d’illustration, non contractuelles.</p>
    </div>
  </div>
</footer>

<style>
  .pied {
    padding-block: var(--e-6) calc(var(--e-4) + env(safe-area-inset-bottom));
    background: var(--pierre-ombre);
    font-size: var(--t-petit);
  }

  .pied__grille {
    display: grid;
    grid-template-columns: minmax(0, 2fr) repeat(3, minmax(0, 1fr));
    gap: var(--e-4);
  }

  .pied__nom {
    font-family: var(--serif);
    font-size: clamp(2.5rem, 1.8rem + 2.6vw, 4.25rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.03em;
  }

  .pied__colonne {
    display: grid;
    align-content: start;
    gap: 0.35rem;
  }

  .pied a {
    text-decoration-color: var(--braise-texte);
  }

  .pied__colonne a {
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  /* Zone de clic agrandie sans décaler la mise en page. */
  .pied__colonne a,
  .pied__liens a {
    display: inline-block;
    padding-block: 0.3rem;
    margin-block: -0.3rem;
  }

  .pied__colonne a:hover {
    text-decoration: underline;
  }

  .pied__liens {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem var(--e-3);
  }

  .pied__bas {
    grid-column: 1 / -1;
    display: grid;
    gap: 0.35rem;
    margin-top: var(--e-4);
    padding-top: var(--e-3);
    border-top: 1px solid var(--trait);
    color: var(--encre-douce);
    font-size: 0.875rem;
  }

  @media (max-width: 56rem) {
    .pied__grille {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .pied__nom {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 48rem) {
    .pied {
      padding-bottom: calc(var(--e-4) + 5rem + env(safe-area-inset-bottom));
    }
  }

  @media (max-width: 34rem) {
    .pied__grille {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--e-3);
    }

    .pied__liens {
      flex-direction: column;
      gap: 0.6rem;
    }
  }
</style>
