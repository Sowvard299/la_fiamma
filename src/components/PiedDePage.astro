---
import { infos } from '../data/infos';
import { photos } from '../data/photos';

const annee = new Date().getFullYear();
const credits = Object.values(photos);
---

<footer class="pied">
  <div class="pied__grille conteneur">
    <p class="pied__nom">{infos.nom}</p>

    <div class="pied__colonne">
      <p>{infos.description}</p>
      <p>{`${infos.adresse.rue}, ${infos.adresse.codePostal} ${infos.adresse.ville}`}</p>
    </div>

    <div class="pied__colonne">
      <p><a class="chiffres" href={`tel:${infos.telephone.international}`}>{infos.telephone.affichage}</a></p>
      <p><a href={`mailto:${infos.email}`}>{infos.email}</a></p>
    </div>

    <div class="pied__colonne">
      <p><a href="#carte">La carte</a></p>
      <p><a href="#avis">Avis</a></p>
      <p><a href="#acces">Accès et horaires</a></p>
      <p><a href="#reserver">Réserver</a></p>
    </div>

    <div class="pied__bas">
      <p>© {annee} {infos.nom}. Prix nets, service compris.</p>
      <p>
        Photos d’illustration, non contractuelles, sous licence Unsplash :
        {
          credits.map((c, i) => (
            <>
              <a href={c.page} rel="noopener">
                {c.auteur}
              </a>
              {i < credits.length - 1 ? ', ' : '.'}
            </>
          ))
        }
      </p>
    </div>
  </div>
</footer>

<style>
  .pied {
    padding-block: var(--e-6) calc(var(--e-4) + env(safe-area-inset-bottom));
    background: var(--pierre-ombre);
    font-size: var(--t-petit);
  }

  .pied__grille {
    display: grid;
    grid-template-columns: minmax(0, 2fr) repeat(3, minmax(0, 1fr));
    gap: var(--e-4);
  }

  .pied__nom {
    font-family: var(--serif);
    font-size: clamp(2.5rem, 1.8rem + 2.6vw, 4.25rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.03em;
  }

  .pied__colonne {
    display: grid;
    align-content: start;
    gap: 0.35rem;
  }

  .pied a {
    text-decoration-color: var(--braise-texte);
  }

  .pied__colonne a {
    text-decoration: none;
  }

  .pied__colonne a:hover {
    text-decoration: underline;
  }

  .pied__bas {
    grid-column: 1 / -1;
    display: grid;
    gap: 0.35rem;
    margin-top: var(--e-4);
    padding-top: var(--e-3);
    border-top: 1px solid var(--trait);
    color: var(--encre-douce);
    font-size: 0.875rem;
  }

  @media (max-width: 56rem) {
    .pied__grille {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .pied__nom {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 48rem) {
    .pied {
      padding-bottom: calc(var(--e-4) + 5rem + env(safe-area-inset-bottom));
    }
  }
</style>
