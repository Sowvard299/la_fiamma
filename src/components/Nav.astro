---
import Flamme from './Flamme.astro';
---

<header class="nav">
  <a class="nav__marque" href="#haut"><Flamme titre="La Fiamma, haut de page" /></a>
  <nav aria-label="Navigation principale">
    <ul class="nav__liens">
      <li><a href="#carte">Carte</a></li>
      <li><a href="#horaires">Horaires</a></li>
      <li><a class="nav__reserver" href="#reserver">Réserver</a></li>
    </ul>
  </nav>
</header>

<style>
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-3);
    padding: calc(var(--e-2) + env(safe-area-inset-top)) var(--marge) var(--e-2);
    color: var(--pierre);
  }

  .nav__marque {
    display: block;
    font-size: 2.25rem;
    color: var(--braise);
    transition: color 0.4s var(--ease);
  }

  .nav__marque:hover {
    color: var(--braise-vive);
  }

  .nav__liens {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    font-size: var(--t-petit);
    font-variation-settings: 'wght' 520;
  }

  .nav__liens a {
    text-decoration: none;
    padding-block: 0.4rem;
    background: linear-gradient(currentColor, currentColor) left bottom / 0 1px no-repeat;
    transition: background-size 0.45s var(--ease);
  }

  .nav__liens a:hover {
    background-size: 100% 1px;
  }

  .nav__reserver {
    color: var(--braise);
  }
</style>
