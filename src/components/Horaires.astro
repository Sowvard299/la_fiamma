---
import { infos } from '../data/infos';
import { NOMS_JOURS, plagesFr, type JourIso } from '../lib/horaires';

const jours = [1, 2, 3, 4, 5, 6, 7] as JourIso[];
---

<table class="horaires">
  <caption class="sr">Horaires d'ouverture</caption>
  <tbody>
    {
      jours.map((j) => (
        <tr data-jour={j} class:list={{ 'horaires--ferme': infos.horaires[j].length === 0 }}>
          <th scope="row">{NOMS_JOURS[j]}</th>
          <td>{plagesFr(infos.horaires[j])}</td>
        </tr>
      ))
    }
  </tbody>
</table>

<script>
  import { momentAParis } from '../lib/horaires';
  // Le jour en cours, à Paris, est mis en avant.
  const { jour } = momentAParis(new Date());
  document.querySelector(`.horaires tr[data-jour="${jour}"]`)?.setAttribute('aria-current', 'date');
</script>

<style>
  .horaires {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--t-petit);
  }

  th,
  td {
    padding: 0.6rem 0;
    text-align: left;
    font-weight: inherit;
    border-top: 1px solid var(--trait);
  }

  tr:last-child > * {
    border-bottom: 1px solid var(--trait);
  }

  th {
    width: 11.5rem;
    text-transform: capitalize;
    color: var(--encre-douce);
  }

  .horaires--ferme td {
    color: var(--encre-douce);
  }

  tr[aria-current] th,
  tr[aria-current] td {
    color: var(--encre);
    font-variation-settings: 'wght' 650;
  }

  tr[aria-current] th::after {
    content: ' (aujourd’hui)';
    font-variation-settings: 'wght' 420;
    color: var(--encre-douce);
    text-transform: none;
  }

  @media (max-width: 40rem) {
    th {
      width: 7.5rem;
    }

    tr[aria-current] th::after {
      display: block;
      font-size: 0.8125rem;
    }
  }
</style>
