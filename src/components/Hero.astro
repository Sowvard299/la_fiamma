---
import Nav from './Nav.astro';
import Statut from './Statut.astro';
import { infos } from '../data/infos';
import { itineraire } from '../lib/liens';
---

<section class="feu" id="haut" data-feu>
  <canvas class="feu__toile" data-feu-canvas aria-hidden="true"></canvas>
  <Nav />

  <h1 class="nom" data-nom>
    <span class="nom__la" data-ligne>La</span>
    <span class="nom__fiamma" data-ligne>Fiamma</span>
  </h1>

  <div class="feu__bas">
    <p class="feu__statut"><Statut /></p>
    <p class="feu__lieu">
      {infos.description}<br />
      <a href={itineraire.google}>{infos.adresse.rue}, {infos.adresse.ville}</a>
    </p>
    <p class="feu__actions">
      <a class="bouton bouton--braise" href={`tel:${infos.telephone.international}`}>
        <span>Appeler<span class="feu__numero"> le <span class="chiffres">{infos.telephone.affichage}</span></span></span>
      </a>
      <a class="feu__carte" href="#carte">Voir la carte</a>
    </p>
  </div>
</section>

<script>
  import { allumer } from '../scripts/chaleur';
  const feu = document.querySelector<HTMLElement>('[data-feu]');
  if (feu) allumer(feu);
</script>

<style>
  .feu {
    position: relative;
    isolation: isolate;
    container-type: inline-size;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto 1fr auto;
    min-height: 100svh;
    overflow: hidden;
    color: var(--pierre);
    background: var(--nuit);
  }

  .feu__toile {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
  }

  .nom {
    align-self: end;
    padding-inline: var(--marge);
    color: var(--pierre);
    letter-spacing: -0.03em;
    /* Le nom est dessiné par le WebGL ; le texte reste là, sélectionnable et lu. */
    transition: color 0.3s linear;
  }

  :global(.feu--gl) .nom {
    color: transparent;
  }

  .nom__la,
  .nom__fiamma {
    display: block;
    width: fit-content;
  }

  .nom {
    /* « Fiamma » mesure 4,08 em en Young Serif avec ce tracking : il tient pile dans la largeur. */
    --fiamma: min(calc((100cqi - 2 * var(--marge)) / 4.12), 44svh);
  }

  .nom__la {
    font-size: max(2.5rem, calc(var(--fiamma) * 0.34));
    line-height: 1;
    margin-left: 0.04em;
  }

  .nom__fiamma {
    font-size: var(--fiamma);
    line-height: 0.88;
    margin-left: -0.04em;
  }

  .feu__bas {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
    align-items: end;
    gap: var(--e-3) var(--e-4);
    padding: var(--e-4) var(--marge) calc(var(--e-4) + env(safe-area-inset-bottom));
    font-size: var(--t-texte);
    line-height: 1.45;
  }

  .feu__statut {
    font-family: var(--serif);
    font-size: clamp(1.25rem, 1.05rem + 0.6vw, 1.625rem);
    line-height: 1.2;
  }

  /* Posé sur la lueur du feu : pierre pleine pour rester au-dessus de 4,5:1. */
  .feu__lieu {
    color: var(--pierre);
  }

  .feu__lieu a {
    color: var(--pierre);
    text-decoration-color: color-mix(in srgb, var(--pierre) 45%, transparent);
  }

  .feu__lieu a:hover {
    text-decoration-color: var(--braise);
  }

  .feu__actions {
    display: flex;
    align-items: center;
    gap: var(--e-3);
  }

  .feu__carte {
    font-variation-settings: 'wght' 560;
    text-decoration-color: var(--braise);
    text-decoration-thickness: 2px;
    white-space: nowrap;
  }

  @media (max-width: 60rem) {
    .feu__bas {
      grid-template-columns: 1fr;
      gap: var(--e-2);
      padding-top: var(--e-3);
    }

    .feu__actions {
      margin-top: var(--e-1);
      justify-content: space-between;
    }
  }

  .feu__actions .bouton {
    white-space: nowrap;
  }

  @media (max-width: 30rem) {
    .feu__numero {
      display: none;
    }

    .feu__actions .bouton {
      flex: 1;
    }
  }
</style>
