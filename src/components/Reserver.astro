---
import Statut from './Statut.astro';
import { infos } from '../data/infos';
---

<section class="reserver" id="reserver" aria-labelledby="t-reserver">
  <div class="reserver__appel">
    <h2 id="t-reserver" class="reserver__titre">Réserver</h2>
    <p class="reserver__intro">Le plus simple, c'est d'appeler.</p>
    <a class="reserver__tel chiffres" href={`tel:${infos.telephone.international}`}>{infos.telephone.affichage}</a>
    <p class="reserver__statut"><Statut /></p>

    <ul class="reserver__autres">
      <li>
        <span class="reserver__autres-titre">En ligne</span>
        <a class="lien-fort" href={infos.theFork} rel="noopener">Réserver sur TheFork</a>
      </li>
      {
        infos.aEmporter && (
          <li>
            <span class="reserver__autres-titre">À emporter</span>
            <span>Commandez par téléphone.</span>
          </li>
        )
      }
    </ul>
  </div>

  <form class="courriel" data-reservation novalidate>
    <h3 class="courriel__titre">Ou par e-mail</h3>
    <p class="courriel__aide">
      Votre messagerie s'ouvre avec la demande déjà rédigée. Il ne reste qu'à l'envoyer.
    </p>

    <div class="champs">
      <label class="champ champ--large">
        <span>Nom</span>
        <input name="nom" type="text" autocomplete="name" required />
      </label>
      <label class="champ">
        <span>Date</span>
        <input name="date" type="date" required data-date />
      </label>
      <label class="champ">
        <span>Heure</span>
        <select name="heure" required disabled data-heure>
          <option value="">Choisissez une date</option>
        </select>
      </label>
      <label class="champ">
        <span>Personnes</span>
        <input name="couverts" type="number" inputmode="numeric" min="1" max="30" value="2" required />
      </label>
      <label class="champ">
        <span>Téléphone <em>(facultatif)</em></span>
        <input name="telephone" type="tel" autocomplete="tel" />
      </label>
      <label class="champ champ--large">
        <span>Message <em>(facultatif)</em></span>
        <textarea name="message" rows="3"></textarea>
      </label>
    </div>

    <p class="courriel__alerte" data-alerte aria-live="polite"></p>

    <button class="bouton bouton--braise" type="submit">Préparer l'e-mail</button>

    <noscript>
      <p class="courriel__secours">
        Ce formulaire a besoin de JavaScript. Écrivez directement à
        <a href={`mailto:${infos.email}`}>{infos.email}</a>.
      </p>
    </noscript>

    <p class="courriel__secours" data-secours hidden>
      Rien ne s'est ouvert ? Écrivez directement à <a href={`mailto:${infos.email}`}>{infos.email}</a>.
    </p>
  </form>

</section>

<script>
  import { infos } from '../data/infos';
  import { NOMS_JOURS, heureFr } from '../lib/horaires';
  import { jourIsoDeDate, lienMail } from '../lib/reservation';
  import { aujourdhuiAParis, creneaux } from '../lib/creneaux';

  const form = document.querySelector<HTMLFormElement>('[data-reservation]');
  if (form) {
    const alerte = form.querySelector<HTMLElement>('[data-alerte]')!;
    const secours = form.querySelector<HTMLElement>('[data-secours]')!;
    const date = form.querySelector<HTMLInputElement>('[data-date]')!;

    const heure = form.querySelector<HTMLSelectElement>('[data-heure]')!;

    // Pas de réservation dans le passé : aujourd'hui, à Paris.
    date.min = aujourdhuiAParis(new Date()).date;

    // Les heures proposées suivent les horaires du jour choisi.
    const remplirHeures = () => {
      const avant = heure.value;
      heure.replaceChildren();
      const option = (valeur: string, texte: string) => {
        const o = document.createElement('option');
        o.value = valeur;
        o.textContent = texte;
        return o;
      };
      if (!date.value) {
        heure.append(option('', 'Choisissez une date'));
        heure.disabled = true;
        alerte.textContent = '';
        return;
      }
      const liste = creneaux(date.value, infos.horaires, aujourdhuiAParis(new Date()));
      if (liste.length === 0) {
        const jour = jourIsoDeDate(date.value);
        heure.append(option('', 'Aucun créneau'));
        heure.disabled = true;
        alerte.textContent =
          infos.horaires[jour].length === 0
            ? `Le restaurant est fermé le ${NOMS_JOURS[jour]}. Choisissez un autre jour.`
            : 'Il n’y a plus de créneau aujourd’hui. Choisissez un autre jour, ou appelez-nous.';
        return;
      }
      alerte.textContent = '';
      heure.disabled = false;
      heure.append(option('', 'Choisissez une heure'));
      for (const [titre, filtre] of [
        ['Midi', (h: string) => h < '17:00'],
        ['Soir', (h: string) => h >= '17:00'],
      ] as const) {
        const service = liste.filter(filtre);
        if (service.length === 0) continue;
        const groupe = document.createElement('optgroup');
        groupe.label = titre;
        groupe.append(...service.map((h) => option(h, heureFr(h))));
        heure.append(groupe);
      }
      if (liste.includes(avant)) heure.value = avant;
    };
    date.addEventListener('change', remplirHeures);
    remplirHeures();

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      const champs = new FormData(form);
      const texte = (cle: string) => String(champs.get(cle) ?? '');
      window.location.href = lienMail(infos.email, {
        nom: texte('nom'),
        date: texte('date'),
        heure: texte('heure'),
        couverts: Number(texte('couverts')),
        telephone: texte('telephone'),
        message: texte('message'),
      });
      // Sans messagerie configurée, rien ne s'ouvre : on donne l'adresse.
      setTimeout(() => (secours.hidden = false), 1500);
    });
  }
</script>

<style>
  .reserver {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    grid-template-areas: 'appel courriel';
    gap: var(--e-5) var(--e-6);
    padding: var(--e-7) var(--marge);
    color: var(--pierre);
    background: var(--nuit);
  }

  .reserver__appel {
    grid-area: appel;
  }

  .reserver__titre {
    font-size: var(--t-section);
    line-height: 0.98;
    letter-spacing: -0.025em;
  }

  .reserver__intro {
    margin-top: var(--e-4);
    color: var(--pierre-douce);
    font-size: clamp(1.125rem, 1rem + 0.4vw, 1.375rem);
  }

  .reserver__tel {
    display: inline-block;
    margin-top: var(--e-1);
    font-family: var(--serif);
    font-size: clamp(2.75rem, 1rem + 6.4vw, 6rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--braise);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.4s var(--ease);
  }

  .reserver__tel:hover {
    color: var(--braise-vive);
  }

  .reserver__statut {
    margin-top: var(--e-3);
    font-family: var(--serif);
    font-size: 1.25rem;
  }

  .reserver__autres {
    display: grid;
    gap: var(--e-2);
    max-width: 30rem;
    margin-top: var(--e-5);
    padding-top: var(--e-3);
    border-top: 1px solid var(--nuit-trait);
  }

  .reserver__autres li {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    align-items: baseline;
    gap: var(--e-2);
  }

  .reserver__autres-titre {
    font-size: var(--t-petit);
    color: var(--pierre-douce);
  }

  .reserver__autres a {
    color: var(--pierre);
  }

  /* Liste d'heures : flèche dessinée, le reste suit les champs soulignés. */
  .champ select {
    padding-right: 1.75rem;
    -webkit-appearance: none;
    appearance: none;
    background:
      linear-gradient(45deg, transparent 50%, currentColor 50%) right 0.55rem center / 0.4rem 0.4rem no-repeat,
      linear-gradient(-45deg, transparent 50%, currentColor 50%) right 0.15rem center / 0.4rem 0.4rem no-repeat;
    cursor: pointer;
  }

  .champ select:disabled {
    color: var(--pierre-douce);
    cursor: not-allowed;
  }

  .champ select option,
  .champ select optgroup {
    color: var(--encre);
    background: var(--pierre);
  }

  /* Formulaire */
  .courriel {
    grid-area: courriel;
    align-self: start;
    padding: var(--e-5) var(--e-4);
    background: var(--nuit-profonde);
  }

  .courriel__titre {
    font-size: var(--t-groupe);
  }

  .courriel__aide {
    margin-top: var(--e-2);
    max-width: 44ch;
    font-size: var(--t-petit);
    color: var(--pierre-douce);
  }

  .champs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--e-3) var(--e-3);
    margin-top: var(--e-4);
  }

  .champ {
    display: grid;
    gap: 0.4rem;
    font-size: var(--t-petit);
    font-variation-settings: 'wght' 520;
  }

  .champ--large {
    grid-column: 1 / -1;
  }

  .champ em {
    font-style: normal;
    color: var(--pierre-douce);
    font-variation-settings: 'wght' 420;
  }

  .champ input,
  .champ select,
  .champ textarea {
    width: 100%;
    min-height: 3rem;
    padding: 0.65rem 0.1rem;
    border: 0;
    border-bottom: 1px solid var(--pierre-douce);
    border-radius: 0;
    font: inherit;
    font-size: 1.0625rem;
    font-variation-settings: 'wght' 450;
    color: var(--pierre);
    background: transparent;
    color-scheme: dark;
    transition: border-color 0.3s var(--ease);
  }

  .champ textarea {
    resize: vertical;
  }

  .champ input:hover,
  .champ select:hover:not(:disabled),
  .champ textarea:hover {
    border-bottom-color: var(--pierre);
  }

  .champ input:focus-visible,
  .champ select:focus-visible,
  .champ textarea:focus-visible {
    outline: none;
    border-bottom: 2px solid var(--braise);
  }

  .champ input:user-invalid {
    border-bottom-color: var(--erreur);
  }

  .courriel__alerte {
    min-height: 1.5em;
    margin-block: var(--e-3) var(--e-2);
    font-size: var(--t-petit);
    color: var(--braise-vive);
  }

  .courriel__secours {
    margin-top: var(--e-2);
    font-size: var(--t-petit);
    color: var(--pierre-douce);
  }

  .courriel__secours a {
    color: var(--pierre);
  }

  @media (max-width: 64rem) {
    .reserver {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'appel' 'courriel';
      gap: var(--e-5);
      padding-block: var(--e-6) var(--e-5);
    }

    .courriel {
      margin-inline: calc(-1 * var(--marge));
      padding: var(--e-4) var(--marge);
    }
  }

  @media (max-width: 40rem) {
    .champs {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .champ:has([name='telephone']) {
      grid-column: 1 / -1;
    }
  }
</style>
