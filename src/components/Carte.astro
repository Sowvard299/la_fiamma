---
import ListePlats from './ListePlats.astro';
import TableVins from './TableVins.astro';
import { pizzaDuMois, prixFr, sections, type Groupe } from '../data/carte';
import { photos, srcPhoto, srcsetPhoto, type Photo } from '../data/photos';

const photoDe: Record<string, Photo> = {
  antipasti: photos.antipasti,
  insalate: photos.insalate,
  pizze: photos.pizzeHaut,
  pasta: photos.pasta,
  dolci: photos.dolci,
  bar: photos.bar,
  vini: photos.vini,
};

const rubriques = [
  ...sections.map((s) => ({ id: s.id, titre: s.titre, traduction: s.traduction })),
  { id: 'vini', titre: 'Vini', traduction: 'Vins' },
];

const colonnes = (id: string, g: Groupe): 1 | 2 =>
  id === 'insalate' || id === 'bar' || g.titre === 'Rossa' ? 2 : 1;

const pizze = sections.find((s) => s.id === 'pizze')!;
const [rossa, bianca, supplements] = pizze.groupes;
---

<section class="carte" id="carte" aria-labelledby="carte-titre" data-carte>
  <div class="conteneur">
    <header class="carte__tete">
      <h2 id="carte-titre" class="titre-section">La carte</h2>
      <div class="carte__outils">
        <form class="recherche" role="search" data-recherche hidden>
          <label class="sr" for="recherche-plat">Rechercher un plat ou un ingrédient</label>
          <input
            id="recherche-plat"
            class="recherche__champ"
            type="search"
            placeholder="Un plat, un ingrédient…"
            autocomplete="off"
            enterkeyhint="search"
            data-recherche-champ
          />
          <button class="recherche__effacer" type="button" data-recherche-effacer hidden>Effacer</button>
        </form>
        <p class="carte__notes">Prix nets en euros, service compris. Merci de nous signaler toute allergie.</p>
      </div>
    </header>
  </div>

  <div class="onglets" role="tablist" aria-label="Rubriques de la carte">
    <div class="onglets__piste conteneur">
      {
        rubriques.map((r, i) => (
          <a
            class="onglet"
            role="tab"
            id={`onglet-${r.id}`}
            href={`#carte-${r.id}`}
            aria-controls={`carte-${r.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            lang="it"
          >
            {r.titre}
          </a>
        ))
      }
    </div>
  </div>

  <div class="conteneur">
    <div class="resultats" data-resultats aria-live="polite" hidden></div>
    {
      rubriques.map((r) => {
        const section = sections.find((s) => s.id === r.id);
        const photo = photoDe[r.id];
        return (
          <section class="panneau" id={`carte-${r.id}`} role="tabpanel" aria-labelledby={`onglet-${r.id}`}>
            <figure class="panneau__photo">
              <img
                src={srcPhoto(photo, 800, 1000)}
                srcset={srcsetPhoto(photo, [480, 800, 1100], 0.8)}
                sizes="(max-width: 56rem) 100vw, 36vw"
                alt={photo.alt}
                width="800"
                height="1000"
                loading="lazy"
                decoding="async"
              />
            </figure>

            <div class="panneau__contenu">
              <header class="panneau__tete">
                <h3 lang="it">{r.titre}</h3>
                <p>{r.traduction}</p>
              </header>

              {r.id === 'vini' && <TableVins />}

              {r.id === 'pizze' && (
                <>
                  <div class="mois">
                    <p class="mois__titre">Pizza du mois</p>
                    <p class="mois__nom">{pizzaDuMois.nom}</p>
                    <p class="mois__detail">{pizzaDuMois.detail}</p>
                    <p class="mois__prix chiffres">{prixFr(pizzaDuMois.prix)} €</p>
                  </div>
                  <div class="groupe">
                    <h4 class="groupe__titre" lang="it">
                      {rossa.titre} <span class="groupe__note">{rossa.note}</span>
                    </h4>
                    <ListePlats plats={rossa.plats} colonnes={2} />
                  </div>
                  <div class="bianca sur-olive">
                    <div class="groupe">
                      <h4 class="groupe__titre" lang="it">
                        {bianca.titre} <span class="groupe__note">{bianca.note}</span>
                      </h4>
                      <ListePlats plats={bianca.plats} />
                    </div>
                    <div class="groupe bianca__supplements">
                      <h4 class="groupe__titre groupe__titre--petit">{supplements.titre}</h4>
                      <ListePlats plats={supplements.plats} serre />
                    </div>
                  </div>
                </>
              )}

              {section && r.id !== 'pizze' && (
                <div class:list={['groupes', `groupes--${r.id}`]}>
                  {section.groupes.map((g) => (
                    <div class="groupe">
                      {g.titre && (
                        <h4 class="groupe__titre">
                          {g.titre} {g.note && <span class="groupe__note">{g.note}</span>}
                        </h4>
                      )}
                      <ListePlats plats={g.plats} colonnes={colonnes(r.id, g)} serre={r.id === 'bar'} />
                    </div>
                  ))}
                </div>
              )}
            </div>
          </section>
        );
      })
    }
  </div>
</section>

<script>
  import { activerOnglets } from '../lib/onglets';
  import { activerRecherche } from '../scripts/recherche-carte';
  const carte = document.querySelector<HTMLElement>('[data-carte]');
  if (carte) {
    activerOnglets(carte);
    activerRecherche(carte);
  }
</script>

<style>
  .carte {
    padding-block: var(--e-3) var(--e-6);
    scroll-margin-top: var(--entete);
  }

  .carte__tete {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--e-2) var(--e-4);
    margin-bottom: var(--e-4);
    padding-top: var(--e-5);
    border-top: 1px solid var(--trait);
  }

  .carte__outils {
    display: grid;
    gap: var(--e-2);
    width: min(100%, 24rem);
  }

  /* Recherche */
  .recherche {
    position: relative;
    display: flex;
    align-items: center;
  }

  .recherche[hidden] {
    display: none;
  }

  .recherche__champ {
    width: 100%;
    min-height: 3rem;
    padding: 0.6rem 5rem 0.6rem 0;
    border: 0;
    border-bottom: 1px solid var(--encre);
    border-radius: 0;
    font: inherit;
    font-size: 1.0625rem;
    color: var(--encre);
    background: transparent;
    -webkit-appearance: none;
    appearance: none;
  }

  .recherche__champ::placeholder {
    color: var(--encre-douce);
    opacity: 1;
  }

  .recherche__champ::-webkit-search-cancel-button {
    display: none;
  }

  .recherche__champ:focus-visible {
    outline: none;
    border-bottom: 2px solid var(--braise);
  }

  .recherche__effacer {
    position: absolute;
    right: 0;
    min-height: 2.5rem;
    padding: 0 0.25rem;
    border: 0;
    font: inherit;
    font-size: var(--t-petit);
    font-variation-settings: 'wght' 600;
    color: var(--braise-texte);
    background: transparent;
    cursor: pointer;
  }

  .carte[data-recherche='active'] .panneau {
    display: none;
  }

  .carte[data-recherche='active'] .onglet[aria-selected='true'] {
    color: var(--encre-douce);
    box-shadow: none;
  }

  .resultats {
    max-width: 52rem;
    margin-inline: auto;
  }

  .resultats[hidden] {
    display: none;
  }

  :global(.resultats__bilan) {
    margin-bottom: var(--e-4);
    padding-bottom: var(--e-2);
    border-bottom: 1px solid var(--encre);
    font-family: var(--serif);
    font-size: var(--t-groupe);
    font-weight: 500;
  }

  :global(.resultats__liste) {
    display: grid;
    gap: var(--e-3);
  }

  :global(.resultat) {
    display: grid;
    grid-template-columns: auto minmax(1.5rem, 1fr) auto;
    align-items: baseline;
    column-gap: 0.5rem;
  }

  :global(.resultat__nom) {
    font-family: var(--serif);
    font-size: var(--t-plat);
    font-weight: 500;
    line-height: 1.2;
  }

  :global(.resultat__points) {
    align-self: end;
    height: 0.3rem;
    margin-bottom: 0.32em;
    background: radial-gradient(circle, currentColor 0.07rem, transparent 0.09rem) left center / 0.45rem 0.3rem repeat-x;
    opacity: 0.45;
  }

  :global(.resultat__prix) {
    font-size: 1.125rem;
    font-variation-settings: 'wght' 600;
    color: var(--braise-texte);
  }

  :global(.resultat__detail) {
    grid-column: 1 / 3;
    margin-top: 0.15rem;
    font-size: var(--t-petit);
    color: var(--encre-douce);
  }

  :global(.resultat__rubrique) {
    grid-column: 1 / -1;
    justify-self: start;
    margin-top: 0.2rem;
    font-size: 0.875rem;
    font-variation-settings: 'wght' 600;
    color: var(--braise-texte);
    text-decoration-color: var(--braise);
    text-underline-offset: 0.25em;
  }

  .carte__notes {
    max-width: 34ch;
    color: var(--encre-douce);
    font-size: var(--t-petit);
  }

  /* Onglets : une barre qui reste sous l'en-tête pendant la lecture. */
  .onglets {
    position: sticky;
    top: var(--entete);
    z-index: 10;
    margin-bottom: var(--e-5);
    background: var(--pierre);
    border-block: 1px solid var(--trait);
  }

  .onglets__piste {
    display: flex;
    gap: clamp(1.25rem, 3vw, 2.75rem);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .onglets__piste::-webkit-scrollbar {
    display: none;
  }

  .onglet {
    flex: none;
    padding: 1.05rem 0 0.95rem;
    font-family: var(--serif);
    font-size: clamp(1.125rem, 1rem + 0.4vw, 1.375rem);
    font-weight: 500;
    color: var(--encre-douce);
    text-decoration: none;
    box-shadow: inset 0 0 0 transparent;
    transition:
      color 0.3s var(--ease),
      box-shadow 0.4s var(--ease);
  }

  .onglet:hover {
    color: var(--encre);
  }

  .onglet[aria-selected='true'] {
    color: var(--encre);
    box-shadow: inset 0 -2px 0 var(--braise);
  }

  .onglet:focus-visible {
    outline-offset: -3px;
  }

  /* Sans JavaScript, les onglets ne font que défiler : on ne marque pas d'onglet actif. */
  .carte:not([data-onglets]) .onglet[aria-selected='true'] {
    color: var(--encre-douce);
    box-shadow: none;
  }

  /* Rubriques */
  .panneau {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--e-5) clamp(2rem, 5vw, 5.5rem);
    align-items: start;
    scroll-margin-top: calc(var(--entete) + 4.5rem);
  }

  .carte:not([data-onglets]) .panneau + .panneau {
    margin-top: var(--e-6);
  }

  .panneau[hidden] {
    display: none;
  }

  .panneau__photo {
    position: sticky;
    top: calc(var(--entete) + 5.5rem);
  }

  .panneau__photo img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    background: var(--pierre-ombre);
  }

  .panneau__tete {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--e-1) var(--e-3);
    margin-bottom: var(--e-4);
    padding-bottom: var(--e-2);
    border-bottom: 1px solid var(--encre);
  }

  .panneau__tete h3 {
    font-size: clamp(2.25rem, 1.6rem + 2.4vw, 3.75rem);
    letter-spacing: -0.025em;
  }

  .panneau__tete p {
    color: var(--encre-douce);
  }

  .groupes {
    display: grid;
    gap: var(--e-5);
  }

  .groupes--bar {
    gap: var(--e-4);
  }

  .groupe + .groupe,
  .mois + .groupe {
    margin-top: 0;
  }

  .groupe__titre {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.75rem;
    margin-bottom: var(--e-3);
    font-size: var(--t-groupe);
    line-height: 1.15;
  }

  .groupe__titre--petit {
    font-size: 1.25rem;
  }

  .groupe__note {
    font-family: var(--sans);
    font-size: var(--t-petit);
    letter-spacing: 0;
    color: var(--encre-douce);
    font-variation-settings: 'wght' 480;
  }

  /* Pizza du mois : une étiquette braise en tête des pizzas. */
  .mois {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 0.25rem var(--e-3);
    margin-bottom: var(--e-5);
    padding: var(--e-3) var(--e-4) var(--e-4);
    color: var(--nuit-profonde);
    background: var(--braise);
  }

  .mois__titre {
    grid-column: 1 / -1;
    font-size: 0.875rem;
    font-variation-settings: 'wght' 650;
  }

  .mois__nom {
    grid-column: 1 / -1;
    font-family: var(--serif);
    font-size: clamp(3rem, 2rem + 4vw, 5rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.03em;
  }

  .mois__detail {
    font-variation-settings: 'wght' 500;
  }

  .mois__prix {
    font-family: var(--serif);
    font-size: 2rem;
    font-weight: 500;
    line-height: 1;
  }

  /* Pizze bianche : sur l'olive du logo. */
  .bianca {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: var(--e-4);
    margin-top: var(--e-5);
    padding: var(--e-4);
    color: var(--pierre);
    background: var(--olive);
  }

  .bianca .groupe__note {
    color: var(--pierre-ombre);
  }

  .bianca__supplements {
    padding-left: var(--e-4);
    border-left: 1px solid var(--olive-trait);
  }

  @media (max-width: 56rem) {
    .panneau {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--e-4);
    }

    .panneau__photo {
      position: static;
    }

    .panneau__photo img {
      aspect-ratio: 16 / 10;
    }

    .bianca {
      grid-template-columns: minmax(0, 1fr);
      margin-inline: calc(-1 * var(--marge));
      padding: var(--e-4) var(--marge);
    }

    .bianca__supplements {
      padding: var(--e-3) 0 0;
      border-left: 0;
      border-top: 1px solid var(--olive-trait);
    }

    .mois {
      padding: var(--e-3);
    }
  }
</style>
