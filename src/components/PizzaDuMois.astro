---
import { pizzaDuMois, prixFr } from '../data/carte';
---

<section class="mois" aria-labelledby="mois-titre">
  <h2 id="mois-titre" class="mois__titre" lang="it">Pizza<br />del mese</h2>
  <div class="mois__pizza">
    <p class="mois__nom">{pizzaDuMois.nom}</p>
    <p class="mois__detail">{pizzaDuMois.detail}</p>
    <p class="mois__prix chiffres">{prixFr(pizzaDuMois.prix)}<span class="mois__euro"> €</span></p>
  </div>
</section>

<style>
  /* Toute la bande est braise : la couleur porte la région, elle ne la décore pas. */
  .mois {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: end;
    gap: var(--e-4) var(--e-5);
    padding: var(--e-6) var(--marge);
    color: var(--nuit-profonde);
    background: var(--braise);
  }

  .mois__titre {
    font-size: var(--t-rubrique);
    line-height: 0.92;
    letter-spacing: -0.025em;
  }

  .mois__pizza {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--e-1) var(--e-4);
  }

  .mois__nom {
    grid-column: 1 / -1;
    font-family: var(--serif);
    font-size: clamp(5.5rem, 2rem + 13vw, 15rem);
    line-height: 0.8;
    letter-spacing: -0.035em;
    margin-bottom: var(--e-2);
  }

  .mois__detail {
    max-width: 32ch;
    font-size: clamp(1.125rem, 1rem + 0.4vw, 1.375rem);
    line-height: 1.4;
    font-variation-settings: 'wght' 480;
  }

  .mois__prix {
    font-family: var(--serif);
    font-size: clamp(2.25rem, 1.6rem + 2vw, 3.5rem);
    line-height: 1;
  }

  .mois__euro {
    font-size: 0.55em;
  }

  @media (max-width: 52rem) {
    .mois {
      grid-template-columns: 1fr;
      padding-block: var(--e-5);
    }
  }
</style>
