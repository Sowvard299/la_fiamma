---
import Flamme from './Flamme.astro';
import ListePlats from './ListePlats.astro';
import TableVins from './TableVins.astro';
import { sections, type Groupe } from '../data/carte';

const rubriques = [...sections.map((s) => ({ id: s.id, titre: s.titre })), { id: 'vini', titre: 'Vini' }];

// Densité propre à chaque rubrique : la carte ne se lit pas au même rythme partout.
const colonnes = (id: string, g: Groupe): 1 | 2 | 3 => {
  if (id === 'bar') return 1;
  if (id === 'insalate' || g.titre === 'Rossa' || g.titre === 'Bianca') return 2;
  return 1;
};
const pizze = sections.find((s) => s.id === 'pizze')!;
const [rossa, bianca, supplements] = pizze.groupes;
---

<section class="carta" id="carte" aria-labelledby="carta-titre">
  <h2 id="carta-titre" class="sr">La carte</h2>

  <nav class="index" aria-label="Rubriques de la carte" data-index>
    <ol class="index__liste" data-index-liste>
      {
        rubriques.map((r) => (
          <li>
            <a href={`#${r.id}`} data-index-lien={r.id} lang="it">
              {r.titre}
            </a>
          </li>
        ))
      }
    </ol>
    <span class="index__curseur" data-index-curseur aria-hidden="true"><Flamme /></span>
    <div class="index__notes">
      <p>Prix nets en euros, service compris.</p>
      <p><Flamme class="index__maison" /> Porte le nom de la maison.</p>
      <p>Merci de nous signaler toute allergie.</p>
      <p><a href="#reserver">Réserver une table</a></p>
    </div>
  </nav>

  <div class="carta__corps">
    {
      sections.map((s) => (
        <section class:list={['rubrique', `rubrique--${s.id}`]} id={s.id} data-rubrique aria-labelledby={`t-${s.id}`}>
          <header class="rubrique__tete">
            <h3 id={`t-${s.id}`} class="rubrique__titre" lang="it">
              {s.titre}
            </h3>
            <p class="rubrique__traduction">{s.traduction}</p>
          </header>

          {s.id === 'pizze' ? (
            <div class="pizze">
              <div class="groupe">
                <h4 class="groupe__titre" lang="it">
                  {rossa.titre} <span class="groupe__note">{rossa.note}</span>
                </h4>
                <ListePlats plats={rossa.plats} colonnes={2} />
              </div>
              <div class="pizze__bianca sur-olive">
                <div class="groupe">
                  <h4 class="groupe__titre" lang="it">
                    {bianca.titre} <span class="groupe__note">{bianca.note}</span>
                  </h4>
                  <ListePlats plats={bianca.plats} colonnes={2} />
                </div>
                <div class="groupe pizze__supplements">
                  <h4 class="groupe__titre groupe__titre--petit">{supplements.titre}</h4>
                  <ListePlats plats={supplements.plats} colonnes={2} serre />
                </div>
              </div>
            </div>
          ) : (
            <div class="rubrique__groupes">
              {s.groupes.map((g) => (
                <div class="groupe">
                  {g.titre && (
                    <h4 class="groupe__titre">
                      {g.titre} {g.note && <span class="groupe__note">{g.note}</span>}
                    </h4>
                  )}
                  <ListePlats plats={g.plats} colonnes={colonnes(s.id, g)} serre={s.id === 'bar'} />
                </div>
              ))}
            </div>
          )}
        </section>
      ))
    }

    <section class="rubrique rubrique--vini" id="vini" data-rubrique aria-labelledby="t-vini">
      <header class="rubrique__tete">
        <h3 id="t-vini" class="rubrique__titre" lang="it">Vini</h3>
        <p class="rubrique__traduction">Vins</p>
      </header>
      <TableVins />
    </section>

    <div class="carta__notes">
      <p>Prix nets en euros, service compris.</p>
      <p><Flamme class="index__maison" /> Porte le nom de la maison.</p>
      <p>Merci de nous signaler toute allergie.</p>
    </div>
  </div>
</section>

<script>
  import { suivreIndex } from '../scripts/carta-index';
  const carta = document.querySelector<HTMLElement>('#carte');
  if (carta) suivreIndex(carta);
</script>

<style>
  .carta {
    display: grid;
    grid-template-columns: minmax(11rem, 14rem) minmax(0, 1fr);
    gap: var(--e-6);
    max-width: calc(var(--largeur) + 2 * var(--marge));
    margin-inline: auto;
    padding: var(--e-6) var(--marge) var(--e-7);
  }

  /* Index : collé pendant la lecture, la flamme glisse sur la rubrique en cours. */
  .index {
    position: sticky;
    top: var(--e-4);
    align-self: start;
  }

  .index__liste {
    display: grid;
    gap: 0.15rem;
  }

  .index__liste a {
    display: block;
    padding: 0.3rem 0 0.3rem 1.6rem;
    font-family: var(--serif);
    font-size: 1.3125rem;
    line-height: 1.2;
    text-decoration: none;
    color: var(--encre-douce);
    transition:
      color 0.4s var(--ease),
      translate 0.5s var(--ease);
  }

  .index__liste a:hover {
    color: var(--encre);
  }

  .index__liste a[aria-current='true'] {
    color: var(--encre);
    translate: 0.35rem 0;
  }

  .index__curseur {
    position: absolute;
    top: 0;
    left: 0;
    font-size: 1.1rem;
    color: var(--braise);
    opacity: 0;
    translate: 0 var(--y, 0);
    transition:
      translate 0.6s var(--ease),
      opacity 0.4s var(--ease);
  }

  .index[data-actif] .index__curseur {
    opacity: 1;
  }

  .index__notes,
  .carta__notes {
    display: grid;
    gap: var(--e-1);
    font-size: var(--t-petit);
    line-height: 1.45;
    color: var(--encre-douce);
  }

  .index__notes {
    margin-top: var(--e-4);
    padding-top: var(--e-3);
    border-top: 1px solid color-mix(in srgb, var(--encre) 18%, transparent);
  }

  .index__notes a {
    color: var(--encre);
    font-variation-settings: 'wght' 560;
    text-decoration-color: var(--braise);
    text-decoration-thickness: 2px;
  }

  .index__notes :global(.index__maison),
  .carta__notes :global(.index__maison) {
    height: 0.85em;
    color: var(--braise);
    translate: 0 0.1em;
  }

  .carta__notes {
    display: none;
  }

  /* Rubriques */
  .carta__corps {
    display: grid;
    gap: var(--e-7);
    min-width: 0;
  }

  .rubrique {
    scroll-margin-top: var(--e-4);
  }

  .rubrique__tete {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--e-1) var(--e-3);
    margin-bottom: var(--e-5);
  }

  .rubrique__titre {
    font-size: var(--t-rubrique);
    line-height: 0.95;
    letter-spacing: -0.03em;
  }

  .rubrique__traduction {
    font-size: var(--t-texte);
    color: var(--encre-douce);
    font-variation-settings: 'wght' 480;
  }

  .rubrique__groupes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 21rem), 1fr));
    gap: var(--e-5) var(--e-6);
    align-items: start;
  }

  .rubrique--bar .rubrique__groupes {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: var(--e-5) var(--e-5);
  }

  .rubrique--insalate .rubrique__groupes {
    grid-template-columns: 1fr;
  }

  .groupe__titre {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.75rem;
    margin-bottom: var(--e-3);
    font-size: var(--t-groupe);
    line-height: 1.15;
  }

  .groupe__titre--petit {
    font-size: 1.25rem;
  }

  .groupe__note {
    font-family: var(--sans);
    font-size: var(--t-petit);
    letter-spacing: 0;
    color: var(--encre-douce);
    font-variation-settings: 'wght' 480;
  }

  /* Pizze : les rouges sur le papier, les blanches sur l'olive. */
  .pizze {
    display: grid;
    gap: var(--e-5);
  }

  .pizze__bianca {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: var(--e-4) var(--e-5);
    margin-inline: calc(-1 * var(--e-4));
    padding: var(--e-5) var(--e-4);
    color: var(--pierre);
    background: var(--olive);
  }

  .pizze__bianca .groupe__note {
    color: var(--pierre-ombre);
  }

  .pizze__bianca :global(.plats--2) {
    grid-template-columns: 1fr;
  }

  .pizze__supplements {
    padding-left: var(--e-4);
    border-left: 1px solid var(--olive-trait);
  }

  @media (max-width: 64rem) {
    .carta {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      padding-top: 0;
    }

    /* Sur mobile : une barre de rubriques qui défile et reste en haut. */
    .index {
      top: 0;
      z-index: 5;
      margin-inline: calc(-1 * var(--marge));
      padding: 0 var(--marge);
      background: var(--pierre);
      border-bottom: 1px solid color-mix(in srgb, var(--encre) 14%, transparent);
    }

    .index__liste {
      display: flex;
      gap: var(--e-3);
      overflow-x: auto;
      scrollbar-width: none;
      scroll-padding-inline: var(--marge);
    }

    .index__liste::-webkit-scrollbar {
      display: none;
    }

    .index__liste a {
      padding: 0.95rem 0 0.85rem;
      font-size: 1.125rem;
      white-space: nowrap;
      translate: none;
    }

    .index__liste a[aria-current='true'] {
      translate: none;
      box-shadow: inset 0 -2px 0 var(--braise);
    }

    .index__curseur,
    .index__notes {
      display: none;
    }

    .carta__corps {
      gap: var(--e-6);
      padding-top: var(--e-5);
    }

    .rubrique {
      scroll-margin-top: 4rem;
    }

    .rubrique__tete {
      margin-bottom: var(--e-4);
    }

    .carta__notes {
      display: grid;
    }

    .pizze__bianca {
      grid-template-columns: 1fr;
      margin-inline: calc(-1 * var(--marge));
      padding: var(--e-5) var(--marge);
    }

    .pizze__supplements {
      padding: var(--e-4) 0 0;
      border-left: 0;
      border-top: 1px solid var(--olive-trait);
    }
  }
</style>
