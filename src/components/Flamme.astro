---
// La flamme du logo, vectorisée, dans la couleur du texte qui l'entoure.
import brut from '../assets/flamme.svg?raw';

interface Props {
  class?: string;
  titre?: string;
}
const { class: classe, titre } = Astro.props;
const svg = brut.replace(
  '<svg',
  titre ? `<svg role="img" aria-label="${titre}"` : '<svg aria-hidden="true" focusable="false"',
);
---

<span class:list={['flamme', classe]} set:html={svg} />

<style>
  .flamme {
    display: inline-block;
    flex: none;
    width: auto;
    height: 1em;
    aspect-ratio: 800 / 1100;
  }
  .flamme :global(svg) {
    width: 100%;
    height: 100%;
  }
</style>
