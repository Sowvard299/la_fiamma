---
// Un bandeau qui fait défiler les noms des pizzas de la carte.
import { pizzaDuMois, sections } from '../data/carte';

const pizze = sections.find((s) => s.id === 'pizze')!;
const noms = [
  pizzaDuMois.nom,
  ...new Set(pizze.groupes.filter((g) => g.titre !== 'Suppléments').flatMap((g) => g.plats.map((p) => p.nom))),
];
---

<div class="bandeau" aria-hidden="true">
  <div class="bandeau__piste">
    {
      [0, 1].map(() => (
        <p class="bandeau__ligne">
          {noms.map((n) => (
            <span>
              {n}
              <i>·</i>
            </span>
          ))}
        </p>
      ))
    }
  </div>
</div>

<style>
  .bandeau {
    overflow: hidden;
    padding-block: 1.35rem;
    color: var(--pierre);
    background: var(--nuit);
  }

  .bandeau__piste {
    display: flex;
    width: max-content;
    animation: defile 70s linear infinite;
  }

  .bandeau__ligne {
    display: flex;
    flex: none;
    font-family: var(--serif);
    font-size: clamp(1.375rem, 1.1rem + 0.9vw, 1.875rem);
    font-weight: 500;
    white-space: nowrap;
  }

  .bandeau__ligne span {
    padding-left: 0.9em;
  }

  .bandeau__ligne i {
    padding-left: 0.9em;
    font-style: normal;
    color: var(--braise);
  }

  @keyframes defile {
    to {
      translate: -50% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bandeau__piste {
      animation: none;
    }
  }
</style>
